# Flow口播工具 - 敏感凭据环境变量配置示例
# 复制本文件为 .env 并填入真实值，或直接在系统环境变量中配置。
# .env 文件已被 .gitignore 忽略，切勿提交到代码仓库！

# Gladia API Keys (用于视频语音转文字与比对，多个 Key 用逗号分隔支持自动轮换)
GLADIA_API_KEYS=your_gladia_api_key_1,your_gladia_api_key_2

# ElevenLabs API Keys (用于视频语音识别，多个 Key 用逗号分隔支持自动轮换)
ELEVENLABS_API_KEYS=your_elevenlabs_api_key_1,your_elevenlabs_api_key_2
